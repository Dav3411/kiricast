# Copy to web/.env.local. Empty values must be replaced with your own test resources.
# No real credentials or live database values are included.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=""
# Generator also accepts SUPABASE_SERVICE_ROLE_KEY; keep privileged keys server-only.
SUPABASE_SERVICE_ROLE_KEY=""
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
GENERATOR_BASE_URL=http://127.0.0.1:8787
GENERATOR_HOST=127.0.0.1

# Generation calls incur provider charges.
OPENAI_API_KEY=""
# Configure Anthropic credentials separately for story generation.
ANTHROPIC_API_KEY=""
IMAGE_PROVIDER=openai
GEMINI_API_KEY=""
TTS_PROVIDER=elevenlabs
ELEVENLABS_API_KEY=""
# Use a voice available to your own ElevenLabs account.
ELEVENLABS_VOICE_ID=""
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
ELEVENLABS_VOICE_ID_MAP=""
NARRATION_VOICE_ID=""
FFMPEG_BIN=""

# Object storage is required by the job worker.
R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=kiricast-development
MEDIA_TOKEN_SECRET=""
MEDIA_BASE_URL=""
JOB_SOURCE=development
WORKER_POLLING_MODE=true
WORKER_HTTP_PORT=0
WORKER_CRON_SECRET=""
CRON_SECRET=""
WORKER_CRON_URL=""

# Optional integration: registration email (configure a verified sender).
RESEND_API_KEY=""
SIGNUP_OTP_FROM_EMAIL=Kiricast <noreply@example.com>
# Optional video streaming.
CLOUDFLARE_ACCOUNT_ID=""
STREAM_API_TOKEN=""
STREAM_BASE_URL=""
STREAM_SIGNING_KEY=""
STREAM_SIGNING_KEY_ID=""

# Optional payment integration: sandbox only for development.
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""
PAYPAL_WEBHOOK_ID=""
PAYPAL_PAYOUTS_ENABLED=false
# Admin features remain unavailable until explicitly configured.
ADMIN_USER_IDS=""
ADMIN_CREDITS_SECRET=""
ADMIN_AGENTS_SECRET=""
